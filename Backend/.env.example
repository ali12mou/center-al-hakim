PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/alhakimcenter
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# En production : Nginx local est reconnu par défaut. Adapter si proxy distant.
# false désactive la confiance ; ne pas utiliser true.
# TRUST_PROXY=loopback
# Pour une API hébergée séparément, définir AVANT npm run build :
# VITE_API_URL=https://api.votre-domaine.dj

# Obligatoire en production pour les codes OTP administrateur.
# Port 587 : false (STARTTLS obligatoire). Port 465 : true (TLS immédiat).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
