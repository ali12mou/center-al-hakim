PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/alhakimcenter
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# En production derrière un proxy (Nginx, hébergeur) : nombre de proxys, ex. 1
# TRUST_PROXY=1
# Pour une API hébergée séparément, définir AVANT npm run build :
# VITE_API_URL=https://api.votre-domaine.dj

# Facultatif : envoi d’e-mails depuis les actions de l’administration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
